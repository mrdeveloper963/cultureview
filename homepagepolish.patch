+.organic-nav-links {
+  display: flex;
+  align-items: center;
+  gap: var(--space-4);
+  font-size: 14px;
+}
+
+.organic-nav-links a {
+  color: var(--color-text);
+  opacity: 0.75;
+  text-decoration: none;
+  transition: opacity 0.12s ease-out, color 0.12s ease-out;
+}
+
+.organic-nav-links a:hover {
+  opacity: 1;
+  color: var(--color-accent);
+}
+
+.hero-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 380px;
+  align-items: center;
+  gap: var(--space-8);
+}
+
+.hero-visual {
+  position: relative;
+  height: 340px;
+}
+
+.hero-blob {
+  position: absolute;
+  border-radius: 44% 56% 62% 38% / 45% 42% 58% 55%;
+}
+
+.hero-blob-1 {
+  width: 260px;
+  height: 260px;
+  background: var(--color-accent-100);
+  top: 4px;
+  right: 10px;
+  animation: blobFloat 9s ease-in-out infinite;
+}
+
+.hero-blob-2 {
+  width: 190px;
+  height: 190px;
+  background: var(--color-accent-2-100);
+  bottom: 0;
+  left: 0;
+  animation: blobFloat 11s ease-in-out infinite reverse;
+}
+
+@keyframes blobFloat {
+  0%, 100% { transform: translateY(0) scale(1); }
+  50% { transform: translateY(-10px) scale(1.03); }
+}
+
+.hero-flag {
+  position: absolute;
+  border-radius: 50%;
+  overflow: hidden;
+  border: 3px solid var(--color-bg);
+  box-shadow: var(--shadow-md);
+  background: var(--color-surface);
+}
+
+.hero-flag img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  display: block;
+}
+
+.testimonial-avatar {
+  width: 30px;
+  height: 30px;
+  border-radius: 50%;
+  overflow: hidden;
+  border: 1px solid var(--color-divider);
+  flex-shrink: 0;
+}
+
+.testimonial-avatar img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  display: block;
+}
+
+.testimonial-head {
+  display: flex;
+  align-items: center;
+  gap: var(--space-2);
+}
+
 @media (max-width: 960px) {
